# Copy to .env (gitignored) and fill in. Never commit .env.
# Network: QDay Aevum testnet ONLY. Never use the QDay Origin testnet (chainId 44003, rpc.qday.info).

# ---------------------------------------------------------------- chain
AEVUM_CHAIN_ID=44005
AEVUM_RPC_URL=https://rpc-test.qday.info
AEVUM_EXPLORER_URL=https://explorer-test.qday.info
# tUSD8: ERC-20, 6 decimals, EIP-2612 permit
TUSD8_ADDRESS=0x456569838f1d43009A91ebA4263147Afd7233483

# ---------------------------------------------------------------- contracts/script/Deploy.s.sol
# Dispute arbiter (resolveRefund / resolveRelease)
ARBITER_ADDRESS=
# The deployer key is NOT read from here. Pass it to forge on the CLI, preferably as an encrypted keystore:
#   cast wallet import aevum-deployer --interactive
#   forge script script/Deploy.s.sol --rpc-url aevum --broadcast --account aevum-deployer

# ---------------------------------------------------------------- deployed addresses (printed by Deploy.s.sol)
CHANNEL_CORE_ADDRESS=
SUBSCRIPTION_PLANS_ADDRESS=
CUSTODY_ADAPTER_ADDRESS=
CLAIM_TOKEN_ADDRESS=
DISPUTE_MANAGER_ADDRESS=
AGENT_POLICY_ADDRESS=
ECDSA_VERIFIER_ADDRESS=
HYBRID_MLDSA_VERIFIER_ADDRESS=
LOCAL_MESSENGER_ADDRESS=

# ---------------------------------------------------------------- backend
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
# Secret: key that submits settleBatch transactions (0x + 64 hex). Leave empty until needed.
GATEWAY_PRIVATE_KEY=
# Secret: key the watchtower uses for challengeClose (0x + 64 hex). Leave empty until needed.
WATCHTOWER_PRIVATE_KEY=

# ---------------------------------------------------------------- frontend (Vite exposes only VITE_* to the browser; never put secrets here)
VITE_BACKEND_URL=http://127.0.0.1:3001
VITE_CHANNEL_CORE_ADDRESS=
VITE_SUBSCRIPTION_PLANS_ADDRESS=
VITE_AGENT_POLICY_ADDRESS=
VITE_DISPUTE_MANAGER_ADDRESS=
VITE_CLAIM_TOKEN_ADDRESS=
